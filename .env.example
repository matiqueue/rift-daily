# Opcjonalne klucze OAuth 1.0a USOS API (skopiuj ten plik do .env.local)
# Jeśli pozostawisz puste, aplikacja spróbuje wygenerować klucz automatycznie
# lub pozwoli wpisać go w ekranie Diagnostyki USOS API w aplikacji.

EXPO_PUBLIC_USOS_KEY_UKEN=
EXPO_PUBLIC_USOS_SECRET_UKEN=

EXPO_PUBLIC_USOS_KEY_UJ=
EXPO_PUBLIC_USOS_SECRET_UJ=

EXPO_PUBLIC_USOS_KEY_UEK=
EXPO_PUBLIC_USOS_SECRET_UEK=
